PORT=4000
MONGODB_URI=

# Auth / OTP login
# Long random string used to sign session cookies. Required in production.
AUTH_JWT_SECRET=
AUTH_COOKIE_NAME=ms_session

# Email OTP (leave blank in dev to log codes to the console instead of sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Meera Sakhrani <no-reply@meerasakhrani.in>

# SMS OTP via MSG91 (leave blank in dev to log codes to the console instead of sending)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER=MEERAS

# MSG91 OTP Widget — the login flow actually used now. MSG91_AUTH_KEY above
# (the account secret) is reused to verify the widget's access token
# server-side. MSG91_WIDGET_TOKEN_AUTH is the widget's own token (from the
# widget's config page, not the account Authkey) — kept backend-only and
# served to the frontend at runtime via /api/auth/widget/config, never as
# a VITE_ variable.
MSG91_WIDGET_TOKEN_AUTH=

# ICICI Orange PG (Direct Integration)
# UAT MID/key are different from production — ask the bank for each. Download the key from
# the portal: Key Management -> Download Key.
FRONTEND_BASE_URL=http://localhost:5173
ICICI_MERCHANT_ID=100000000455550
ICICI_AGGREGATOR_ID=100000000455549
ICICI_SECRET_KEY=41b6fbc4-e403-4c81-82ae-ccdb6e40a82d
ICICI_INITIATE_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
ICICI_RETURN_URL=http://localhost:4000/api/payments/return
# Shared secret required in the `x-admin-key` header to call the refund endpoint. Leave blank
# to disable refunds until you set one.
ADMIN_API_KEY=
# How often the reconciliation sweep re-checks stuck INITIATED/PENDING payments, and how long
# a payment must sit before it's considered stale enough to re-check.
RECONCILE_INTERVAL_MS=300000
RECONCILE_STALE_AFTER_MS=120000
